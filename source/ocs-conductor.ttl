# ---------------------------------------------------------------------------
# Preset 1 — "Identity (n=n)"
# Every state's bits_change, cc_a_change, and cc_b_change all equal the
# state number n (1–8).  The resulting bit patterns are trivially small
# integers and the CC values mirror them directly, making it easy to verify
# on a MIDI monitor that the correct state fired.
# ---------------------------------------------------------------------------

<https://github.com/OilCanSteve/ocs-conductor/presets/identity>
  a pset:Preset ;
  lv2:appliesTo <https://github.com/OilCanSteve/ocs-conductor> ;
  rdfs:label "Identity (n=n)" ;
  pset:port
    [ lv2:symbol "MidiChannel" ;       pset:value 0 ],
    [ lv2:symbol "EnactChangesOnly" ;  pset:value 0 ],
    [ lv2:symbol "state_trigger" ;     pset:value 0 ],
    [ lv2:symbol "cc_a_num" ;          pset:value 11 ],
    [ lv2:symbol "cc_b_num" ;          pset:value 10 ],
    [ lv2:symbol "ccnum_4_bit_1" ;     pset:value 20 ],
    [ lv2:symbol "ccnum_4_bit_2" ;     pset:value 21 ],
    [ lv2:symbol "ccnum_4_bit_3" ;     pset:value 22 ],
    [ lv2:symbol "ccnum_4_bit_4" ;     pset:value 23 ],
    [ lv2:symbol "ccnum_4_bit_5" ;     pset:value 24 ],
    [ lv2:symbol "ccnum_4_bit_6" ;     pset:value 25 ],
    [ lv2:symbol "ccnum_4_bit_7" ;     pset:value 26 ],
    [ lv2:symbol "Plus8Return" ;        pset:value 1 ],
    # state 1 — all values = 1
    [ lv2:symbol "bits_change_1" ;     pset:value 1 ],
    [ lv2:symbol "cc_a_change_1" ;     pset:value 1 ],
    [ lv2:symbol "cc_b_change_1" ;     pset:value 1 ],
    # state 2 — all values = 2
    [ lv2:symbol "bits_change_2" ;     pset:value 2 ],
    [ lv2:symbol "cc_a_change_2" ;     pset:value 2 ],
    [ lv2:symbol "cc_b_change_2" ;     pset:value 2 ],
    # state 3 — all values = 3
    [ lv2:symbol "bits_change_3" ;     pset:value 3 ],
    [ lv2:symbol "cc_a_change_3" ;     pset:value 3 ],
    [ lv2:symbol "cc_b_change_3" ;     pset:value 3 ],
    # state 4 — all values = 4
    [ lv2:symbol "bits_change_4" ;     pset:value 4 ],
    [ lv2:symbol "cc_a_change_4" ;     pset:value 4 ],
    [ lv2:symbol "cc_b_change_4" ;     pset:value 4 ],
    # state 5 — all values = 5
    [ lv2:symbol "bits_change_5" ;     pset:value 5 ],
    [ lv2:symbol "cc_a_change_5" ;     pset:value 5 ],
    [ lv2:symbol "cc_b_change_5" ;     pset:value 5 ],
    # state 6 — all values = 6
    [ lv2:symbol "bits_change_6" ;     pset:value 6 ],
    [ lv2:symbol "cc_a_change_6" ;     pset:value 6 ],
    [ lv2:symbol "cc_b_change_6" ;     pset:value 6 ],
    # state 7 — all values = 7
    [ lv2:symbol "bits_change_7" ;     pset:value 7 ],
    [ lv2:symbol "cc_a_change_7" ;     pset:value 7 ],
    [ lv2:symbol "cc_b_change_7" ;     pset:value 7 ],
    # state 8 — all values = 8
    [ lv2:symbol "bits_change_8" ;     pset:value 8 ],
    [ lv2:symbol "cc_a_change_8" ;     pset:value 8 ],
    [ lv2:symbol "cc_b_change_8" ;     pset:value 8 ]
  .